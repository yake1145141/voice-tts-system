# 统一换行符，避免 Windows/Linux 协作时 shell 脚本被写成 CRLF 而无法执行
* text=auto

# 脚本：按各平台习惯
*.sh   text eol=lf
*.py   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.apk  binary
*.zip  binary
*.pth  binary
*.index binary
*.pt   binary
*.ipynb text eol=lf

# 模型权重永远不要进版本库
hubert_base.pt binary
rmvpe.pt       binary
